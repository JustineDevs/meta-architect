{
  "version": 1,
  "hooks": [
    {
      "event": "prebuild",
      "action": "deny-unless-gates-green",
      "source": ".ma/decisions.json"
    },
    {
      "event": "prerelease",
      "action": "deny-unless-release-origin-valid",
      "allowedOrigins": ["development", "release/*"]
    }
  ]
}
