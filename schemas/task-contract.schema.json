{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-architect.dev/schemas/task-contract.schema.json",
  "title": "Meta-Architect Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "record_type",
    "goal",
    "context_used",
    "assumptions",
    "constraints",
    "risk",
    "verification",
    "stop_condition"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "record_type": { "const": "task_contract" },
    "goal": { "type": "string", "minLength": 1 },
    "context_used": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "risk": { "enum": ["low", "medium", "high"] },
    "verification": { "type": "array", "items": { "type": "string" } },
    "stop_condition": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "engineering_plan": { "$ref": "engineering-plan.schema.json" },
    "skill_plan": {
      "anyOf": [{ "type": "null" }, { "$ref": "skill-composition-plan.schema.json" }]
    },
    "skill_execution": {
      "anyOf": [{ "type": "null" }, { "$ref": "skill-execution-reference.schema.json" }]
    },
    "persist": { "type": "boolean" },
    "execution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["workspace_root", "mutation_mode", "allowed_paths", "command", "verification"],
      "properties": {
        "workspace_root": { "type": "string", "minLength": 1 },
        "mutation_mode": { "enum": ["read_only", "worktree", "source_write"] },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "command": { "$ref": "#/$defs/command" },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "command": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["file", "args", "timeoutMs"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    }
  }
}
